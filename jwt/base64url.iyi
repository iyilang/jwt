# Base64url without padding, the encoding of every JWS segment (RFC 7515
# §2, RFC 4648 §5).
module jwt/base64url

import std/base64::{Base64}
import std/text

pub struct Base64Url
  # *data* in the URL-safe alphabet, its padding left off.
  def self.encode(data : String) : String
    Base64.urlsafe_encode(data).rstrip('=')
  end

  def self.encode(data : Array(UInt8)) : String
    encode(Base64Url.to_text(data))
  end

  # The bytes *text* encodes, or nil when it is not unpadded base64url: a
  # byte outside the URL-safe alphabet (padding and whitespace included), a
  # length of one more than a multiple of four, or set bits after the last
  # whole byte - which would let two texts carry one signature.
  #
  # `std/base64` panics on what it refuses, and a token is somebody else's
  # input, so the check is made here and the decoding with it.
  def self.decode(text : String) : String?
    n = text.bytesize
    return nil if n % 4 == 1
    src = text.to_unsafe
    i = 0
    while i < n
      return nil if Base64Url.value_of(src[i]) < 0
      i = i + 1
    end
    if n % 4 == 2
      return nil unless Base64Url.value_of(src[n - 1]) & 15 == 0
    elsif n % 4 == 3
      return nil unless Base64Url.value_of(src[n - 1]) & 3 == 0
    end
    String.new(n // 4 * 3 + (n % 4 == 0 ? 0 : n % 4 - 1)) do |dst|
      acc = 0
      bits = 0
      o = 0
      j = 0
      while j < n
        acc = (acc << 6) | Base64Url.value_of(src[j])
        bits = bits + 6
        if bits >= 8
          bits = bits - 8
          dst[o] = ((acc >> bits) & 255).to_u8
          o = o + 1
        end
        acc = acc & 255
        j = j + 1
      end
    end
  end

  # The bytes as a decoded `decode` answers them, as an array.
  def self.decode_bytes(text : String) : Array(UInt8)?
    decoded = decode(text)
    decoded ? decoded.bytes : nil
  end

  # *bytes* as a string of the same bytes.
  def self.to_text(bytes : Array(UInt8)) : String
    String.new(bytes.size) { |dst| dst.copy_from(bytes.to_unsafe, bytes.size) }
  end

  # The six bits *byte* stands for in the URL-safe alphabet, -1 for any
  # other byte.
  def self.value_of(byte : UInt8) : Int32
    if byte >= 65_u8 && byte <= 90_u8
      (byte - 65_u8).to_i32
    elsif byte >= 97_u8 && byte <= 122_u8
      (byte - 97_u8).to_i32 + 26
    elsif byte >= 48_u8 && byte <= 57_u8
      (byte - 48_u8).to_i32 + 52
    elsif byte == 45_u8
      62
    elsif byte == 95_u8
      63
    else
      -1
    end
  end
end
