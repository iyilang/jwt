# ES256, ES384 and ES512: crystal-community/jwt's example tokens verify
# with their keys, ES256 signs, and a JWS signature is r and s side by side
# where std/ecdsa reads DER.
module jwt/ecdsa_test

import jwt
import jwt/algorithms::{Algorithm}
import jwt/base64url::{Base64Url}
import jwt/errors::{InvalidKeyError, UnsupportedAlgorithmError, VerificationError}
import jwt/signatures::{Signer}

# crystal-community/jwt's spec keys and the tokens it signed with them, and
# each key's public half from `openssl ec -pubout`.
