# Another P-256 key, PKCS #8 (`openssl pkcs8 -topk8 -nocrypt`), and its
# public half.
OTHER_PRIVATE = <<-PEM
  -----BEGIN EC PRIVATE KEY-----
  MHcCAQEEIBk+7qAtkmubz1ENCirnccTXGi80aBLAIFs6vfENM6UloAoGCCqGSM49
  AwEHoUQDQgAEWWXgyR0aVz57hI6egnz/BshXtVr4JepP4YIPbfUZA2xc32I6fKkQ
  HBFzGX4At7PHVOp1FEbzR4BvibEGJRjnQA==
  -----END EC PRIVATE KEY-----
  PEM

OTHER_PUBLIC = <<-PEM
  -----BEGIN PUBLIC KEY-----
  MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEWWXgyR0aVz57hI6egnz/BshXtVr4
  JepP4YIPbfUZA2xc32I6fKkQHBFzGX4At7PHVOp1FEbzR4BvibEGJRjnQA==
  -----END PUBLIC KEY-----
  PEM

test "crystal-community/jwt's tokens verify with the public key and with the private key" do
  [{Algorithm::ES256, P256_TOKEN, P256_PUBLIC, P256_PRIVATE},
   {Algorithm::ES384, P384_TOKEN, P384_PUBLIC, P384_PRIVATE},
   {Algorithm::ES512, P521_TOKEN, P521_PUBLIC, P521_PRIVATE}].each do |vector|
    algorithm, token, public_key, private_key = vector
    [public_key, private_key].each do |key|
      decoded = Jwt.decode(token, key, algorithm).or_panic
      assert_eq "bar", decoded.payload["foo"].as_s
      assert_eq algorithm.to_s, decoded.header["alg"].as_s
    end
  end
end

test "a raw signature is DER's r and s, crystal-community/jwt's vector" do
  signature = Base64Url.decode_bytes(P256_TOKEN.split('.')[2]) || [] of UInt8
  expected = [48, 69, 2, 32, 20, 109, 91, 228, 28, 143, 233, 226, 40, 94, 197,
              239, 173, 212, 233, 140, 254, 31, 192, 101, 142, 143, 90, 177, 123,
              35, 228, 199, 37, 238, 150, 195, 2, 33, 0, 216, 81, 133, 104, 175,
              149, 90, 242, 228, 134, 82, 74, 231, 227, 89, 84, 173, 31, 96, 11, 82,
              226, 194, 118, 53, 92, 245, 196, 11, 240, 131, 176].map(&.to_u8)
  der = Signer.raw_to_der(signature)
  assert_eq expected, der
  assert_eq signature, Signer.der_to_raw(der, 32).or_panic
end

test "P-521's 66-byte halves take DER's long length form, and leading zeros come back" do
  signature = Base64Url.decode_bytes(P521_TOKEN.split('.')[2]) || [] of UInt8
  assert_eq 132, signature.size
  der = Signer.raw_to_der(signature)
  assert_eq [0x30_u8, 0x81_u8], der[0, 2]
  assert_eq signature, Signer.der_to_raw(der, 66).or_panic
  zeros = Array(UInt8).new(64, 0_u8)
  zeros[31] = 1_u8
  zeros[32] = 0x80_u8
  assert_eq [0x30_u8, 38_u8, 2_u8, 1_u8, 1_u8, 2_u8, 33_u8, 0_u8, 0x80_u8], Signer.raw_to_der(zeros)[0, 9]
  assert_eq zeros, Signer.der_to_raw(Signer.raw_to_der(zeros), 32).or_panic
end

test "ES256 signs with a SEC 1 or a PKCS #8 key, and the token verifies" do
  pkcs8 = <<-PEM
    -----BEGIN PRIVATE KEY-----
    MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgGT7uoC2Sa5vPUQ0K
    KudxxNcaLzRoEsAgWzq98Q0zpSWhRANCAARZZeDJHRpXPnuEjp6CfP8GyFe1Wvgl
    6k/hgg9t9RkDbFzfYjp8qRAcEXMZfgC3s8dU6nUURvNHgG+JsQYlGOdA
    -----END PRIVATE KEY-----
    PEM
  [OTHER_PRIVATE, pkcs8].each do |key|
    token = Jwt.encode({"foo" => "bar"}, key, Algorithm::ES256).or_panic
    assert_eq 86, token.split('.')[2].bytesize
    assert_eq "bar", Jwt.decode(token, OTHER_PUBLIC, Algorithm::ES256).or_panic.payload["foo"].as_s
    assert_eq "bar", Jwt.decode(token, pkcs8, Algorithm::ES256).or_panic.payload["foo"].as_s
  end
end

test "ES384 and ES512 verify only" do
  [{Algorithm::ES384, P384_PRIVATE}, {Algorithm::ES512, P521_PRIVATE}].each do |pair|
    algorithm, key = pair
    refusal = assert_error(UnsupportedAlgorithmError) { Jwt.encode({"foo" => "bar"}, key, algorithm) }
    assert_includes refusal.message, "verifies but does not sign"
  end
end

test "another key, another curve, a signature of the wrong size" do
  refusal = assert_error(VerificationError) { Jwt.decode(P256_TOKEN, OTHER_PUBLIC, Algorithm::ES256) }
  assert_eq "Signature verification failed", refusal.message
  curve = assert_error(InvalidKeyError) { Jwt.decode(P384_TOKEN, P256_PUBLIC, Algorithm::ES384) }
  assert_eq "an EC key on P256, where the algorithm takes P384", curve.message
  assert_error(InvalidKeyError) { Jwt.decode(P256_TOKEN, "secret", Algorithm::ES256) }
  parts = P256_TOKEN.split('.')
  short = "#{parts[0]}.#{parts[1]}.#{parts[2][0, 84]}"
  assert_error(VerificationError) { Jwt.decode(short, P256_PUBLIC, Algorithm::ES256) }
end
