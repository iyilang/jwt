# A 1024-bit public key, under RFC 7518's floor.
PUBLIC_1024 = <<-PEM
  -----BEGIN PUBLIC KEY-----
  MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC6Cgkk+AgS/Pe5n0q8fsgvz4gp
  Dhaw2mcU6t4xoAvmMeIBaAiY0EMgSCkjc4vRZ9m2liRZMxrYJEj6uTURCW2MFwcF
  7sRA41/B7OHAnT67PKlJerjLvPY4MvHeJ6CO/zkypmexRENI6wgBGgTLxYJdg/GF
  ABwVY0PpDry2OPCmMQIDAQAB
  -----END PUBLIC KEY-----
  PEM

# P-256, for the refusal of a key of the wrong kind.
EC_PUBLIC = <<-PEM
  -----BEGIN PUBLIC KEY-----
  MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEWWXgyR0aVz57hI6egnz/BshXtVr4
  JepP4YIPbfUZA2xc32I6fKkQHBFzGX4At7PHVOp1FEbzR4BvibEGJRjnQA==
  -----END PUBLIC KEY-----
  PEM

ALGORITHMS = [Algorithm::RS256, Algorithm::RS384, Algorithm::RS512, Algorithm::PS256, Algorithm::PS384, Algorithm::PS512]

test "a token signed here verifies with the public key in either form, or the private key" do
  ALGORITHMS.each do |algorithm|
    token = Jwt.encode({"foo" => "bar"}, PRIVATE, algorithm).or_panic
    [PUBLIC, PUBLIC_PKCS1, PRIVATE].each do |key|
      decoded = Jwt.decode(token, key, algorithm).or_panic
      assert_eq "bar", decoded.payload["foo"].as_s
      assert_eq algorithm.to_s, decoded.header["alg"].as_s
    end
  end
end

test "tokens OpenSSL signed verify" do
  # `openssl dgst -sha256 -sign` over the first two segments.
  rs256 = "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJvcGVuc3NsIn0.M6kkV3_6YQgKpOufvIojQo6ppzuQ-fvoZlOckg1e9pnJLSoNVCTs-8hdI5tbcz3cuWc62u9YmCir9YVls1cD6vacBfiUrz8ExhDBypNdfoXMlXJ3xPjAfOLA07nZwQAlgoOtPT5n00nGHZSIkaskhNsa4uR92qTfezXG2ySKIl19f3uZvxF3A9i26Jzua38HOKoDthA27-kYAg8Xkdu4ynOCEGUNabe0OOGLrwAAnBgzMFXzWHfi3p1oA7IANj-8NywVJxNiD0LwzpmdK4sTJCslfOzz6hKk56XZDI3WcqkOCLvPuxb0vtGXrJ-ix7iJ5gX3O2zlbRRkZRpCZVAccA"
  assert_eq "openssl", Jwt.decode(rs256, PUBLIC, Algorithm::RS256).or_panic.payload["sub"].as_s
  # `openssl dgst -sha384 -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:digest -sign`.
  ps384 = "eyJhbGciOiJQUzM4NCIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJvcGVuc3NsIn0.PU5HWC8nZKPVWZyqgMR3NZ3BQ2dqFi8s-OoIwvC3T_nYv3UDxA0Z8fK_o14IfFxlDNsESdtXZR1gMeRV7DnmWVU16HuHAGTZPdIAk0LIuokEEbkcQoo6AEmkI8fzHpukNy61PiGJkFafjZVn_Uthl8CJ1yOLb5nDr4mqrjKj0xEi7VzYGQV8r4ZeW-6axW1ReryRERbc11k-mVGycGBzdc6rllYdHFUdWCrqko0W4SyyfL3JAAddZDge-1i8fPKZebyrtm0LuhI0KOpLS-Xl7bNIfmoQBQEplamZ_MayAMgQ38ZwubjUlRZCSNfY5yyj_l9v3Q_hRhkg0vU376Y_cw"
  assert_eq "openssl", Jwt.decode(ps384, PUBLIC_PKCS1, Algorithm::PS384).or_panic.payload["sub"].as_s
end

test "a token altered after signing is refused" do
  token = Jwt.encode({"admin" => false}, PRIVATE, Algorithm::RS256).or_panic
  parts = token.split('.')
  altered = Jwt.encode({"admin" => true}, PRIVATE, Algorithm::RS256).or_panic.split('.')[1]
  refusal = assert_error(VerificationError) { Jwt.decode("#{parts[0]}.#{altered}.#{parts[2]}", PUBLIC, Algorithm::RS256) }
  assert_eq "Signature verification failed", refusal.message
  # RS256 and PS256 signatures are not each other's.
  ps = Jwt.encode({"admin" => false}, PRIVATE, Algorithm::PS256).or_panic.split('.')
  rs_header = parts[0]
  assert_error(VerificationError) { Jwt.decode("#{rs_header}.#{ps[1]}.#{ps[2]}", PUBLIC, Algorithm::RS256) }
end

test "keys the RSA algorithms do not take" do
  token = Jwt.encode({"foo" => "bar"}, PRIVATE, Algorithm::RS256).or_panic
  short = assert_error(InvalidKeyError) { Jwt.decode(token, PUBLIC_1024, Algorithm::RS256) }
  assert_eq "a 1024-bit RSA key; RFC 7518 requires 2048 bits or more", short.message
  assert_error(InvalidKeyError) { Jwt.decode(token, EC_PUBLIC, Algorithm::RS256) }
  assert_error(InvalidKeyError) { Jwt.decode(token, "secret", Algorithm::RS256) }
  assert_error(InvalidKeyError) { Jwt.encode({"foo" => "bar"}, PUBLIC, Algorithm::RS256) }
  assert_error(InvalidKeyError) { Jwt.encode({"foo" => "bar"}, "secret", Algorithm::PS256) }
end
